<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>java-sdk</artifactId>
        <groupId>io.keploy</groupId>
        <version>2.0.6</version>
    </parent>

    <artifactId>keploy-sdk</artifactId>
    <version>2.0.6</version>
    <name>Keploy Java Coverage Agent</name>
    <description>Java dynamic dedup coverage agent for Keploy Enterprise</description>
    <url>https://github.com/keploy/java-sdk</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jacoco.version>0.8.15</jacoco.version>
        <!-- The test JVM's heap. Left to the JVM, it is a quarter of the machine's RAM (of the host's when the
             JVM does not see its container's limit), and the build table rows allocate enough for JDK 8's
             collector to grow the heap past a 4 GiB container's limit. -DargLine=... overrides it. -->
        <argLine>-Xmx1g</argLine>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>sarthak160</id>
            <name>Sarthak</name>
            <email>sarthak@keploy.io</email>
        </developer>
        <developer>
            <id>gouravkrosx</id>
            <name>Gourav Kumar</name>
            <email>gourav.kumar@keploy.io</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git@github.com:keploy/java-sdk.git</connection>
        <developerConnection>scm:git@github.com:keploy/java-sdk.git</developerConnection>
        <url>https://github.com/keploy/java-sdk.git</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.9.1</version>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.core</artifactId>
            <!-- Keep in step with k8s-proxy dedupinject.BundledJaCoCoVersion: this
                 dependency is what shades ASM into keploy-sdk.jar, and that shaded
                 ASM is an independent ceiling on the Java bytecode dynamic dedup can
                 instrument. While this sat on 0.8.12 it, not the jacocoagent in the
                 init image, was what capped dedup at Java 22. -->
            <version>${jacoco.version}</version>
        </dependency>
        <dependency>
            <!-- The tests' copy of jacocoagent.jar (AgentJar). keploy-sdk.jar
                 carries only the jacocoagent.jar inside this artifact, unpacked
                 below as io/keploy/dedup/jacocoagent.jar, not its AgentJar class. -->
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.agent</artifactId>
            <version>${jacoco.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.kohlschutter.junixsocket</groupId>
            <artifactId>junixsocket-common</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>com.kohlschutter.junixsocket</groupId>
            <artifactId>junixsocket-native-common</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- The servers whose requests END waits for, run by ServerTailTest.
             The last lines that run Java 8, as the SDK's tests do. -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>9.0.121</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <version>9.4.57.v20241219</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-servlet</artifactId>
            <version>2.2.37.Final</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.jboss.spec.javax.servlet</groupId>
                    <artifactId>jboss-servlet-api_4.0_spec</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The schedulers whose job runs a test's window is checked for, run by
             JobTailTest. The last lines that run Java 8; Quartz's connection pools
             are for its JDBC job store, which the test does not use. -->
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <version>2.3.2</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.mchange</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.zaxxer</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>5.3.39</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- keploy-sdk's own license, Apache 2.0, which the Gson and junixsocket
                 the jar carries are under too: META-INF/LICENSE in the jar, next to
                 THIRD-PARTY-NOTICES.txt and JaCoCo's LICENSE-EPL-2.0.txt. -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- jacocoagent.jar, carried unchanged, which the SDK starts with
                     includes= the app's classes when the command attaches no JaCoCo
                     agent of its own (EmbeddedJacoco). It goes in under
                     io/keploy/dedup, not at the jar's root where org.jacoco.agent
                     keeps it, and without that artifact's AgentJar class:
                     keploy-sdk.jar is on the system class path, so either one would
                     be what an app's own org.jacoco.agent finds in a loader that
                     asks the system class loader first (Spring Boot's
                     BOOT-INF/lib), and an app's own on the class path ahead of
                     keploy-sdk.jar would be the agent the SDK starts. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <!-- Unpacked once into target/jacocoagent, which also holds the
                             plugin's marker, so deleting that directory unpacks it again.
                             It is not unpacked into target/classes: replacing the file there
                             would touch its directory, and jar:jar would rebuild the jar on
                             release.yml's no-clean deploy pass. -->
                        <id>unpack-jacocoagent</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <markersDirectory>${project.build.directory}/jacocoagent/markers</markersDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.jacoco</groupId>
                                    <artifactId>org.jacoco.agent</artifactId>
                                    <version>${jacoco.version}</version>
                                    <type>jar</type>
                                    <includes>jacocoagent.jar</includes>
                                    <outputDirectory>${project.build.directory}/jacocoagent/classes/io/keploy/dedup</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Copies the unpacked jacocoagent.jar into target/classes. It copies
                     only a missing or older file, so a cleared target/classes gets it
                     back and a build without clean leaves the jar as it was. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-jacocoagent</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/jacocoagent/classes</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <id>shade-java-agent</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>io.keploy.dedup.KeployDedupAgent</Premain-Class>
                                        <Agent-Class>io.keploy.dedup.KeployDedupAgent</Agent-Class>
                                        <Can-Redefine-Classes>false</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <Implementation-Title>${project.name}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Automatic-Module-Name>io.keploy.sdk</Automatic-Module-Name>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <!-- keploy-sdk.jar is on the app's system class path, as every
                                 -javaagent jar is, so a library it carried under its own name
                                 would be the copy the app's code gets, ahead of the app's own
                                 version (Spring Boot's BOOT-INF/lib asks the system class loader
                                 first), and keploy-sdk's code would get the app's version when
                                 the app's jars come first (-cp /app/libs/*). So keploy-sdk.jar
                                 carries these under io.keploy.shaded. junixsocket keeps its names:
                                 its native library is bound to them. A Java string that starts
                                 with one of these patterns is rewritten too (shouldSkipClass). -->
                            <relocations>
                                <relocation>
                                    <pattern>org.jacoco.core</pattern>
                                    <shadedPattern>io.keploy.shaded.org.jacoco.core</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.objectweb.asm</pattern>
                                    <shadedPattern>io.keploy.shaded.org.objectweb.asm</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>io.keploy.shaded.com.google.gson</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Spring 6.2 (Spring Boot 3.4's) for ServerTailTest's row that runs the
                 app on it: the test class path keeps Spring 5.3, which runs on Java 8,
                 and the row puts these jars on its app's class path in its place.
                 Spring 6 needs Java 17, so the profile is on only there. Test-only:
                 nothing here goes in a jar, and a build with -DskipTests skips it. -->
            <id>spring6-rows</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-spring6</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <skip>${skipTests}</skip>
                                    <outputDirectory>${project.build.directory}/spring6</outputDirectory>
                                    <artifactItems>
                                        <artifactItem><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><version>6.2.12</version></artifactItem>
                                        <artifactItem><groupId>org.springframework</groupId><artifactId>spring-aop</artifactId><version>6.2.12</version></artifactItem>
                                        <artifactItem><groupId>org.springframework</groupId><artifactId>spring-beans</artifactId><version>6.2.12</version></artifactItem>
                                        <artifactItem><groupId>org.springframework</groupId><artifactId>spring-core</artifactId><version>6.2.12</version></artifactItem>
                                        <artifactItem><groupId>org.springframework</groupId><artifactId>spring-expression</artifactId><version>6.2.12</version></artifactItem>
                                        <artifactItem><groupId>org.springframework</groupId><artifactId>spring-jcl</artifactId><version>6.2.12</version></artifactItem>
                                        <artifactItem><groupId>io.micrometer</groupId><artifactId>micrometer-observation</artifactId><version>1.14.12</version></artifactItem>
                                        <artifactItem><groupId>io.micrometer</groupId><artifactId>micrometer-commons</artifactId><version>1.14.12</version></artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
